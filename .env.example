# GemmaMorph Environment Configuration
# Track 1: Best Use of Gemma 4

# Option A: Hosted API Runner (Fast, 0 MB download)
GROQ_API_KEY=your_groq_api_key_here
LLM_BACKEND=groq
GEMMA_MODEL=gemma2-9b-it

# Option B: Local Offline Runner (Ollama)
# LLM_BACKEND=ollama
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_HOST=http://localhost:11434

TARGET_REPO=../LinkWatch
